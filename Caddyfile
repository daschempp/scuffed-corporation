# Redirect www to the bare apex domain.
www.scuffedcorporation.com {
	redir https://scuffedcorporation.com{uri} permanent
}

scuffedcorporation.com {
	root * /srv
	encode gzip zstd

	# Assets are unversioned (no content hash in the filename), so a long
	# max-age would pin a stale stylesheet after a deploy. "no-cache" still
	# lets the browser store the file — it just revalidates first, and
	# file_server answers with a 304 off the ETag, so repeat visits cost
	# almost nothing while a deploy is picked up immediately.
	header Cache-Control "no-cache"

	file_server

	# Serve the handwritten 404 page for any not-found path.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
